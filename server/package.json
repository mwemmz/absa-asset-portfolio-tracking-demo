{
  "name": "@absa-demo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio tracking demo API + vehicle simulation engine",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "reset": "node --env-file-if-exists=.env src/seed.js --force",
    "smoke": "node scripts/smoke.js",
    "fetch-routes": "node scripts/fetch-routes.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.5",
    "express": "^4"
  }
}
