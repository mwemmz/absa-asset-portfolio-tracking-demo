# Copy to server/.env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Leave TURSO_URL empty to use the local SQLite file in server/data/ (zero setup).
# Set both values to point the API at a remote Turso / libSQL database.
# Find the URL with:  turso db show <db-name> --url
# Create a token with: turso db tokens create <db-name>
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Server ----------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SIM_ENABLED=true

# --- Simulation ------------------------------------------------------------
TICK_MS=5000
PROLONGED_STOP_MS=600000
DEVIATION_THRESHOLD_M=800
OFFLINE_TIMEOUT_MS=180000
POSITION_RETENTION_DAYS=3