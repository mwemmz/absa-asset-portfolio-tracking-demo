{
  "name": "lusaka-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lusaka 1 - Asset Portfolio Tracking dashboard (simulated data)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "reset": "npm run reset --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}